<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Sensor Registration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #8a2be2;
            --primary-dark: #5a189a;
            --secondary: #ff9e00;
            --accent: #ff2d75;
            --dark: #121212;
            --darker: #0a0a0a;
            --light: rgba(255, 255, 255, 0.9);
            --glass: rgba(255, 255, 255, 0.05);
            --success: #00e676;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(-45deg, #0f0c29, #302b63, #24243e);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            color: var(--light);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            width: 100%;
            max-width: 900px;
            background: rgba(18, 18, 18, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        .container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(138, 43, 226, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
            z-index: -1;
        }

        @keyframes rotate {
            100% { transform: rotate(360deg); }
        }

        h1 {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 30px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            position: relative;
            display: inline-block;
            width: 100%;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border-radius: 3px;
        }

        h2 {
            font-size: 1.3rem;
            margin: 30px 0 15px;
            color: var(--secondary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        h2 i {
            font-size: 1.1rem;
        }

        .form-group {
            margin-bottom: 25px;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 10px;
            font-weight: 500;
            color: var(--light);
        }

        .required::after {
            content: " *";
            color: var(--accent);
        }

        input[type="text"],
        input[type="email"],
        input[type="tel"],
        input[type="url"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 15px 20px;
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            font-size: 16px;
            color: var(--light);
            transition: all 0.3s ease;
        }

        input::placeholder,
        textarea::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(138, 43, 226, 0.3);
            background: rgba(138, 43, 226, 0.1);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .file-upload {
            position: relative;
            margin: 15px 0;
        }

        .file-upload input {
            width: 100%;
            padding: 15px;
            opacity: 0;
            position: absolute;
            z-index: 2;
            cursor: pointer;
        }

        .file-upload-label {
            display: block;
            padding: 15px 20px;
            background: var(--glass);
            border: 1px dashed rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            text-align: center;
            transition: all 0.3s;
        }

        .file-upload:hover .file-upload-label {
            border-color: var(--primary);
            background: rgba(138, 43, 226, 0.1);
        }

        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .radio-option {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .radio-option input {
            appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid var(--gray);
            border-radius: 50%;
            transition: all 0.2s;
            position: relative;
            cursor: pointer;
        }

        .radio-option input:checked {
            border-color: var(--primary);
        }

        .radio-option input:checked::after {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            width: 10px;
            height: 10px;
            background: var(--primary);
            border-radius: 50%;
        }

        .radio-option label {
            margin-bottom: 0;
            cursor: pointer;
        }

        button {
            background: linear-gradient(45deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 18px;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 600;
            width: 100%;
            margin-top: 20px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(138, 43, 226, 0.3);
        }

        button:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(138, 43, 226, 0.4);
        }

        button::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                to bottom right,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.1) 50%,
                rgba(255, 255, 255, 0) 100%
            );
            transform: rotate(30deg);
            transition: all 0.3s;
        }

        button:hover::after {
            left: 100%;
        }

        .error {
            color: var(--accent);
            font-size: 14px;
            margin-top: 8px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .success-message {
            background: rgba(0, 230, 118, 0.15);
            color: var(--success);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            text-align: center;
            font-weight: 600;
            display: none;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(0, 230, 118, 0.2);
            animation: fadeIn 0.5s;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Floating decoration elements */
        .decor {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.3;
            z-index: -1;
        }

        .decor-1 {
            width: 300px;
            height: 300px;
            background: var(--primary);
            top: -100px;
            right: -100px;
        }

        .decor-2 {
            width: 200px;
            height: 200px;
            background: var(--secondary);
            bottom: -50px;
            left: -50px;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .container {
                padding: 30px 20px;
            }

            h1 {
                font-size: 2rem;
            }

            .radio-group {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="decor decor-1"></div>
        <div class="decor decor-2"></div>
        
        <h1>Sensor Product Registration</h1>
        
        <div id="successMessage" class="success-message">
            <i class="fas fa-check-circle"></i> Thank you! Your submission has been received.
        </div>

        <form id="sensorForm">
            <h2><i class="fas fa-building"></i> Company Information</h2>
            
            <div class="form-group">
                <label for="companyName" class="required">Company Name</label>
                <input type="text" id="companyName" name="companyName" placeholder="Enter company name" required>
                <div id="companyNameError" class="error"><i class="fas fa-exclamation-circle"></i> This field is required</div>
            </div>
            
            <div class="form-group">
                <label for="contactPerson" class="required">Contact Person</label>
                <input type="text" id="contactPerson" name="contactPerson" placeholder="Full name" required>
                <div id="contactPersonError" class="error"><i class="fas fa-exclamation-circle"></i> This field is required</div>
            </div>
            
            <div class="form-group">
                <label for="email" class="required">Email Address</label>
                <input type="email" id="email" name="email" placeholder="email@example.com" required>
                <div id="emailError" class="error"><i class="fas fa-exclamation-circle"></i> Please enter a valid email</div>
            </div>
            
            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="+1 (123) 456-7890">
            </div>
            
            <div class="form-group">
                <label for="website">Website URL</label>
                <input type="url" id="website" name="website" placeholder="https://example.com">
            </div>
            
            <div class="form-group">
                <label for="logo">Company Logo</label>
                <div class="file-upload">
                    <input type="file" id="logo" name="logo" accept="image/*">
                    <label for="logo" class="file-upload-label">
                        <i class="fas fa-cloud-upload-alt"></i> Click to upload logo
                    </label>
                </div>
            </div>
            
            <h2><i class="fas fa-microchip"></i> Sensor Details</h2>
            
            <div class="form-group">
                <label for="productName" class="required">Product Name</label>
                <input type="text" id="productName" name="productName" placeholder="e.g., XYZ Temperature Sensor" required>
                <div id="productNameError" class="error"><i class="fas fa-exclamation-circle"></i> This field is required</div>
            </div>
            
            <div class="form-group">
                <label for="sensorType" class="required">Sensor Type</label>
                <select id="sensorType" name="sensorType" required>
                    <option value="">Select a sensor type</option>
                    <option value="Temperature">Temperature</option>
                    <option value="Pressure">Pressure</option>
                    <option value="Motion">Motion</option>
                    <option value="Humidity">Humidity</option>
                    <option value="Gas">Gas</option>
                    <option value="Optical">Optical</option>
                    <option value="Proximity">Proximity</option>
                    <option value="IoT">IoT Sensor</option>
                    <option value="Other">Other</option>
                </select>
                <div id="sensorTypeError" class="error"><i class="fas fa-exclamation-circle"></i> Please select a type</div>
            </div>
            
            <div class="form-group">
                <label for="modelNumber" class="required">Model Number</label>
                <input type="text" id="modelNumber" name="modelNumber" placeholder="e.g., XYZ-1234" required>
                <div id="modelNumberError" class="error"><i class="fas fa-exclamation-circle"></i> This field is required</div>
            </div>
            
            <div class="form-group">
                <label for="specifications" class="required">Key Specifications</label>
                <textarea id="specifications" name="specifications" placeholder="e.g., Range: -40°C to 125°C, Accuracy: ±0.5°C" required></textarea>
                <div id="specificationsError" class="error"><i class="fas fa-exclamation-circle"></i> This field is required</div>
            </div>
            
            <div class="form-group">
                <label for="datasheet">Datasheet (PDF)</label>
                <div class="file-upload">
                    <input type="file" id="datasheet" name="datasheet" accept=".pdf">
                    <label for="datasheet" class="file-upload-label">
                        <i class="fas fa-file-pdf"></i> Upload PDF datasheet
                    </label>
                </div>
            </div>
            
            <button type="submit">
                <i class="fas fa-paper-plane"></i> Submit Product
            </button>
        </form>
    </div>

    <script>
        document.getElementById('sensorForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Hide all errors initially
            document.querySelectorAll('.error').forEach(el => el.style.display = 'none');
            
            // Validate required fields
            let isValid = true;
            
            const requiredFields = [
                { id: 'companyName', errorId: 'companyNameError' },
                { id: 'contactPerson', errorId: 'contactPersonError' },
                { id: 'email', errorId: 'emailError' },
                { id: 'productName', errorId: 'productNameError' },
                { id: 'sensorType', errorId: 'sensorTypeError' },
                { id: 'modelNumber', errorId: 'modelNumberError' },
                { id: 'specifications', errorId: 'specificationsError' }
            ];
            
            requiredFields.forEach(field => {
                const element = document.getElementById(field.id);
                if (!element.value.trim()) {
                    document.getElementById(field.errorId).style.display = 'flex';
                    isValid = false;
                }
            });
            
            // Validate email format
            const email = document.getElementById('email').value;
            if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                document.getElementById('emailError').style.display = 'flex';
                isValid = false;
            }
            
            if (isValid) {
                // Show success message with animation
                const successMsg = document.getElementById('successMessage');
                successMsg.style.display = 'block';
                
                // Add confetti effect (optional)
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 }
                    });
                }
                
                // Reset form
                setTimeout(() => {
                    document.getElementById('sensorForm').reset();
                    successMsg.style.display = 'none';
                }, 4000);
            }
        });

        // Add animation to file upload labels
        document.querySelectorAll('.file-upload input').forEach(input => {
            input.addEventListener('change', function() {
                const label = this.nextElementSibling;
                if (this.files.length > 0) {
                    label.innerHTML = `<i class="fas fa-check-circle"></i> ${this.files[0].name}`;
                    label.style.borderColor = 'var(--success)';
                } else {
                    label.innerHTML = `<i class="fas fa-cloud-upload-alt"></i> Click to upload`;
                    label.style.borderColor = 'rgba(255, 255, 255, 0.3)';
                }
            });
        });
    </script>

    <!-- Optional: Confetti library for celebration effect -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
</body>
</html>
